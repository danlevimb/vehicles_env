      <aliases enabled='yes' />
      <column caption='Fecha Día' datatype='date' name='[Calculation_1648036040339570688]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([trending_date])' />
      </column>
      <column caption='MA 7 días' datatype='real' name='[Calculation_1648036040339775489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([videos_count]),-6,0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Abs vs 7 días ' datatype='integer' name='[Calculation_1648036040340119554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([videos_count]) - LOOKUP(SUM([videos_count]), -7)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Participación categoría' datatype='real' name='[Calculation_1648036040340336643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([videos_count]) / TOTAL(SUM([videos_count]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Últimos 30 días' datatype='boolean' name='[Calculation_1648036040340955140]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[trending_date] &gt;= DATEADD(&apos;day&apos;, -30, {MAX([trending_date])})' />
      </column>

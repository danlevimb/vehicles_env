      <aliases enabled='yes' />
      <column caption='Móvil Average (7 días)' datatype='real' name='[Calculation_1648036040610291717]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([videos_count]),-6,0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Absoluto vs 7 días ' datatype='integer' name='[Calculation_1648036040610635782]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([videos_count]) - LOOKUP(SUM([videos_count]),-7)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Participacion Categoría' datatype='real' name='[Calculation_1648036040610869255]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([videos_count]) / TOTAL(SUM([videos_count]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top N' datatype='boolean' name='[Calculation_1648036040611340296]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_DENSE(SUM([videos_count]),&apos;desc&apos;) &lt;= [Parameters].[Parámetro 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Últimos 30 días' datatype='boolean' name='[Calculation_1648036040611561481]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[trending_date] &gt;= DATEADD(&apos;day&apos;, -30, {MAX([trending_date])})' />
      </column>
      <column caption='Fecha Día' datatype='date' name='[Calculation_1648036040613335050]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([trending_date])' />
      </column>
